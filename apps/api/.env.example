# apps/api: variables de la API (copiar a apps/api/.env.local)
# OJO: el service role key es solo para el servidor — nunca al SPA.

# Supabase
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon key publica>
SUPABASE_SERVICE_ROLE_KEY=<service role - SOLO server>

# Run
WEB_ORIGIN=http://localhost:5173
# Origen del panel de plataforma (segundo SPA). Opcional: sin él solo
# WEB_ORIGIN pasa CORS.
PLATFORM_ORIGIN=http://localhost:5174
PORT=8787
CRON_SECRET=<secreto compartido con el cron de recordatorios>

# Plataforma (opcional): salt para hashear IPs de solicitudes. Sin él se
# usa el service role como material del hash.
PLATFORM_IP_SALT=<string aleatorio>

# Alerta de errores por Telegram (opcional)
TELEGRAM_BOT_TOKEN=<token del bot>
TELEGRAM_CHAT_ID=<chat id destino>

# Traza de llamadas API -> Supabase en consola (dev). Default: activo fuera
# de producción. 0/false/off lo desactiva; 1/true/on lo fuerza.
LOG_SUPABASE=1
