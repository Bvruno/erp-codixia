{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/lib/supabase/*": ["./src/lib/supabase/*"],
      "@/lib/auth/*": ["./src/lib/auth/*"],
      "@/lib/audit": ["./src/lib/audit.ts"],
      "@/lib/telegram-plataforma": ["./src/lib/telegram-plataforma.ts"],
      "@/lib/telegram-bot": ["./src/lib/telegram-bot.ts"],
      "@/lib/org-export": ["./src/lib/org-export.ts"],
      "@/lib/captura-errores": ["./src/lib/captura-errores.ts"],
      "@/lib/*": ["../../packages/shared/src/logica/*"],
      "@/types": ["../../packages/shared/src/types.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}