# SPA plataforma (panel de owners)
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key publica>

# Dev: NO definir VITE_API_URL. El proxy de Vite reenvía /api → localhost:8787
# (sin CORS). En producción, definir la URL absoluta de la API en Render y
# añadir el origen del panel a PLATFORM_ORIGIN en apps/api/.env.
# VITE_API_URL=https://api.tu-dominio.com
