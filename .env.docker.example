# =============================================================================
# Variables para el stack docker del ERP (copiar a .env y rellenar).
# En Coolify estos valores se configuran como "Environment Variables".
# NUNCA commitear el .env real.
# =============================================================================

# --- Postgres ----------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_PASSWORD=<password aleatorio>

# --- Supabase interno ----------------------------------------------------------
# Secreto con el que se firman/verifican los JWT (gotrue, postgrest, realtime,
# storage y la API). Generador: docker/generar-claves.mjs
JWT_SECRET=<secreto aleatorio>
ANON_KEY=<jwt role=anon firmado con JWT_SECRET>
SERVICE_ROLE_KEY=<jwt role=service_role firmado con JWT_SECRET>
SECRET_KEY_BASE=<secreto aleatorio 48+ chars>
REALTIME_DB_ENC_KEY=<16+ caracteres>
PG_META_CRYPTO_KEY=<base64 de 32 bytes>
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=<password aleatorio>

# --- URLs públicas -------------------------------------------------------------
# Kong (auth + rest + realtime + storage) y la web.
API_EXTERNAL_URL=https://supabase-erp.varillas.work
SITE_URL=https://erp.varillas.work

# --- SMTP (mailpit local por defecto) ------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@varillas.work
SMTP_SENDER_NAME=ERP Codixia

# --- Storage (backend local en disco) -------------------------------------------
GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=stub
REGION=local

# --- API ------------------------------------------------------------------------
# Igual en Coolify que en la API (Render/local). URL pública de la API para el
# webhook de Telegram y para el SPA.
API_PUBLIC_URL=https://api-erp.varillas.work
API_WS_URL=wss://api-erp.varillas.work/cws
# Origen extra permitido por CORS (p. ej. acceso directo por LAN).
PLATFORM_ORIGIN=http://192.168.1.59:8400
CRON_SECRET=<secreto compartido con el cron de recordatorios>
PLATFORM_IP_SALT=<string aleatorio>
TELEGRAM_BOT_TOKEN=<token del bot de plataforma (opcional)>
TELEGRAM_CHAT_ID=<chat destino por defecto (opcional)>
