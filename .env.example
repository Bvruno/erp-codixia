# Raíz: la API lee estas variables
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon key publica>
SUPABASE_SERVICE_ROLE_KEY=<service role - SOLO server>
WEB_ORIGIN=http://localhost:5173
PORT=8787
CRON_SECRET=<secreto compartido con el cron de recordatorios>

# Traza de llamadas API → Supabase en consola (dev). Default: activo fuera
# de producción. 0/false/off lo desactiva; 1/true/on lo fuerza.
LOG_SUPABASE=1
